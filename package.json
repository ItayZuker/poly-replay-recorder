{
  "name": "poly-replay-recorder",
  "version": "1.0.0",
  "description": "Standalone Polymarket up/down recorder with a week coverage board",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dest": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3"
  }
}
